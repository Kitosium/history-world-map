{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history-world-map.local/schemas/source.schema.json",
  "title": "Source record",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "type",
    "title",
    "critique_and_reliability"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^src-[a-z0-9-]+$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "type": {
      "enum": [
        "historical_atlas",
        "authoritative_cartography",
        "linked_open_data",
        "academic_monograph",
        "primary_chronicle",
        "reference_work"
      ]
    },
    "title": {
      "type": "object",
      "required": [
        "canonical"
      ],
      "properties": {
        "canonical": {
          "$ref": "#/$defs/localisedText"
        },
        "short": {
          "$ref": "#/$defs/localisedText"
        }
      },
      "additionalProperties": true
    },
    "creators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "affiliation": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "publication": {
      "type": "object",
      "properties": {
        "publisher": {
          "type": "string"
        },
        "year": {
          "type": [
            "integer",
            "string"
          ]
        },
        "place": {
          "type": "string"
        },
        "edition": {
          "type": "string"
        },
        "volumes": {
          "type": "string"
        },
        "pages": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "isbn": {
          "type": "string"
        },
        "oclc": {
          "type": "string"
        },
        "snapshot_date": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "digital_access": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "access_type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "page_url": {
            "type": "string",
            "format": "uri"
          },
          "license": {
            "type": "string"
          },
          "license_url": {
            "type": "string",
            "format": "uri"
          },
          "local_file": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "pages": {
            "type": "integer",
            "minimum": 1
          },
          "retrieved": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "spdx": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object"
    },
    "critique_and_reliability": {
      "type": "object",
      "required": [
        "tier"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "description": "Must exist in data/taxonomies/source-tiers.json"
        },
        "historiographical_notes": {
          "type": "string"
        },
        "spatial_precision_rating": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "citation_formats": {
      "type": "object",
      "properties": {
        "chicago": {
          "type": "string"
        },
        "apa": {
          "type": "string"
        },
        "bibtex": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "localisedText": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
